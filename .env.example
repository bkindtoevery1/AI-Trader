# Toss Invest Open API credentials
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=

# Optional account selector.
# Leave both blank when GET /api/v1/accounts returns exactly one usable account.
TOSSINVEST_ACCOUNT_SEQ=
TOSSINVEST_ACCOUNT_NO=

# Optional Telegram notification.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live trading remains disabled unless config allows it and CLI uses --execute.
AI_TRADER_CONFIG=config/strategy.yaml
